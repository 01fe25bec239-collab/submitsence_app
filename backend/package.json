{
  "name": "@submitsense/api",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start:dev": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker/worker.ts",
    "worker:prod": "node dist/worker/worker.js",
    "manifest:generate": "node --import tsx src/db/migrate/manifest.ts generate",
    "manifest:check": "node --import tsx src/db/migrate/manifest.ts check",
    "manifest:history": "node --import tsx src/db/migrate/manifest.ts check-history",
    "migrate:plan": "node --import tsx src/db/migrate/runner.ts plan --json",
    "migrate:execute": "node --import tsx src/db/migrate/runner.ts execute --json",
    "render:package-fixture": "node --import tsx scripts/render-package-fixture.ts",
    "verify:package-worker": "node --import tsx scripts/verify-package-worker.ts",
    "verify:risk-rfi-worker": "node --import tsx scripts/verify-risk-rfi-worker.ts",
    "test": "node --import tsx --test test/*.test.mjs test/*.test.ts",
    "test:application": "node --import tsx --test $(find test -maxdepth 1 \\( -name '*.test.mjs' -o -name '*.test.ts' \\) -not -name '*.pg.test.ts')",
    "test:pg:migration": "node --import tsx --test test/migration-execute.pg.test.ts",
    "test:pg:identity": "node --import tsx --test test/database-identity.pg.test.ts",
    "test:pg:commercial": "node --import tsx --test test/commercial-webhook.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1086.0",
    "@aws-sdk/client-s3": "^3.1086.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "aws-jwt-verify": "^4.0.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
